<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- CameraX Viewfinder Surface -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        app:scaleType="fillCenter" />

    <!-- Participant Study Accessible Primary View (Default) -->
    <LinearLayout
        android:id="@+id/participantCardLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#DD111827"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvParticipantGuidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="assertive"
            android:contentDescription="Live guidance: Proceed forward along corridor."
            android:text="Proceed forward along corridor."
            android:textColor="@color/safe_green"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvParticipantStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="System status: PRISM active, sensors operational."
            android:text="Status: PRISM Active | Sensors Operational"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Research Debug HUD Overlay (Visible only in Research Debug Mode) -->
    <LinearLayout
        android:id="@+id/debugHudLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hud_background"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/participantCardLayout">

        <TextView
            android:id="@+id/tvCameraStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMERA: INITIALIZING | FRAME: 0"
            android:textColor="@color/safe_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRuntimeState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="STATE: RUNNING"
            android:textColor="@color/safe_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFpsAndLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="FPS: 0.0 | Latency: 0.0 ms | Drops: 0"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDecision"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ACTION: CONTINUE (no_hazard)"
            android:textColor="@color/safe_green"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRisk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="RISK: SAFE (Score: 0.0, TTC: N/A, CPA: N/A)"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvObstacleDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TRACKS: 0 | OBSTACLES: 0"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvServerUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="SERVER: http://localhost:8080"
            android:textColor="#38bdf8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Primary Controls: START and STOP -->
    <LinearLayout
        android:id="@+id/bottomControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/safe_green"
            android:contentDescription="Start PRISM navigation assistant"
            android:minHeight="56dp"
            android:text="START"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/critical_red"
            android:contentDescription="Stop PRISM navigation assistant"
            android:minHeight="56dp"
            android:text="STOP"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
