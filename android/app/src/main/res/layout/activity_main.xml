<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- CameraX Viewfinder Surface -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        app:scaleType="fillCenter" />

    <!-- Participant Study Accessible Primary View (Default) -->
    <LinearLayout
        android:id="@+id/participantCardLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#DD111827"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvParticipantDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Current destination: North Concourse Exit"
            android:text="DESTINATION: North Concourse Exit"
            android:textColor="#38bdf8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvParticipantGuidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="assertive"
            android:contentDescription="Live guidance: Proceed forward along corridor."
            android:text="Proceed forward along corridor."
            android:textColor="@color/safe_green"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvParticipantStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:contentDescription="System status: PRISM active, sensors operational."
            android:text="Status: PRISM Active | Sensors Operational"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Research Debug HUD Overlay (Visible only in Research Debug Mode) -->
    <LinearLayout
        android:id="@+id/debugHudLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hud_background"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/participantCardLayout">

        <TextView
            android:id="@+id/tvCameraStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMERA: INITIALIZING | FRAME: 0"
            android:textColor="@color/safe_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRuntimeState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="STATE: RUNNING"
            android:textColor="@color/safe_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFpsAndLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="FPS: 0.0 | Latency: 0.0 ms | Drops: 0"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDecision"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ACTION: CONTINUE (no_hazard)"
            android:textColor="@color/safe_green"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRisk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="RISK: SAFE (Score: 0.0, TTC: N/A, CPA: N/A)"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvObstacleDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TRACKS: 0 | OBSTACLES: 0"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvServerUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="SERVER: http://localhost:8080"
            android:textColor="#38bdf8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Accessible Voice / Query Buttons Row -->
    <LinearLayout
        android:id="@+id/accessibleQueriesLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsLayout">

        <Button
            android:id="@+id/btnWhereAmI"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:contentDescription="Query location: Where am I?"
            android:minHeight="48dp"
            android:text="Where Am I?"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnWhatIsAhead"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:contentDescription="Query obstacles: What is ahead?"
            android:minHeight="48dp"
            android:text="What's Ahead?"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRepeatInstruction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:contentDescription="Repeat last navigation instruction"
            android:minHeight="48dp"
            android:text="Repeat"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Floating Action / Primary Controls -->
    <LinearLayout
        android:id="@+id/bottomControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnToggleRuntime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Pause navigation"
            android:minHeight="48dp"
            android:text="PAUSE" />

        <Button
            android:id="@+id/btnSelectDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Select navigation destination"
            android:minHeight="48dp"
            android:text="DESTINATION" />

        <Button
            android:id="@+id/btnReleaseMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Toggle UI mode between Participant and Research Debug"
            android:minHeight="48dp"
            android:text="MODE: STUDY" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
